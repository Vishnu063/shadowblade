; Shadowblade: The Last Guardian — Godot 4.6
config_version=5

[application]
config/quit_on_go_back=false
config/name="Shadowblade: The Last Guardian"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]
Progress="*res://scripts/progress.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
lights_and_shadows/directional_shadow/size=1024
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.045, 0.10, 0.13, 1)
textures/default_filters/use_nearest_mipmap_filter=false
